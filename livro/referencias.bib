@article{Rommetveit2008,
abstract = {Background: More than 80{\\%} of non-Hodgkin lymphomas (NHLs) occurring in transplant recipients on immunosuppressive therapy are associated with Epstein-Barr virus (EBV) infection. EBV viral load (EBV-VL) is predictive of NHL occurrence in this setting. The aim of this work was to determine EBV-VL in patients with Crohn's disease (CD), both according to disease activity and use of immunosuppressive therapy, including infliximab. Methods: Between December 1999 and July 2001, EBV-VL was determined 212 times by quantitative polymerase chain reaction (PCR) assay in 138 patients with CD and in 24 EBV-seropositive controls free of CD. Results: EBV-VL did not differ significantly between the controls and the patients with CD and was not influenced by CD activity or by immunosuppressive therapy, including recent infliximab infusion. High EBV-VL values were observed in two patients with severe uncontrolled CD, but returned to normal once the flare-up had been controlled (by immunosuppressive drugs in one case and by surgery in the other case). Conclusions: EBV viral load is on the whole similar in patients with Crohn's disease and in EBV-seropositive controls. Infliximab infusion does not seem to increase significantly EBV-VL in the short term. However, some patients with Crohn's disease have transient, very high EBV-VL values that are compatible with an increased risk of NHL in the transplant setting. The long-term clinical outcome of these patients must be determined. Copyright {\textcopyright} 2004 by Lippincott Williams {\&} Wilkins.},
author = {Rommetveit, Rolv and Bjorkevoll, Knut Steinar and Odegaard, Sven Inge and Herbert, Mike C. and Halsey, George Wesley},
doi = {10.2118/112533-MS},
file = {:C$\backslash$:/Users/1540 LITE/Documents/Mendeley Desktop/Rommetveit et al/SPE Digital Energy Conference and Exhibition held/Rommetveit et al. - 2007 - eDrilling A System for Real-Time Drilling Simulation , 3D Visualization , and Control.pdf:pdf;:C$\backslash$:/Users/1540 LITE/Documents/Mendeley Desktop/Rommetveit et al/SPE Digital Energy Conference and Exhibition held/Rommetveit et al. - 2007 - eDrilling A System for Real-Time Drilling Simulation , 3D Visualization , and Control.pdf:pdf},
isbn = {1078-0998},
issn = {1078-0998},
journal = {IADC/SPE Drilling Conference},
keywords = {,drilling,edrilling,virtual well},
mendeley-tags = {drilling,edrilling,virtual well},
pmid = {15168806},
title = {{Automatic Real-Time Drilling Supervision, Simulation, 3D Visualization, and Diagnosis on Ekofisk}},
url = {http://www.onepetro.org/doi/10.2118/112533-MS},
year = {2008}
}

@misc{Saini2018,
abstract = {AbstractFor many decades now, navigational aids have been able to not only provide an initial estimate of the time to destination, but also update it in real-time, accounting for ever changing outside circumstances. The digital drilling twin aims can achieve the same and more for the well construction process. Creating a digital twin is a complex undertaking wherein real-time data and physics-based models are integrated with historical data to provide real-time recommendations about future course of action. This paper details the creation, implementation and testing of a drilling digital twin for one aspect of the well delivery process. We demonstrate the concept by creating a twin that makes predictions on time to section total depth. Time to total depth depends primarily on two factors: the performance while drilling, which is primarily quantified by rate of penetration (ROP), and the performance when not drilling, which is quantified by the times for the various well delivery tasks, such as tripping, circulation, making connections etc. ROP is dependent on downhole rock formations, hole and bit condition and drilling parameters, and can be predicted with a physics-based model in combination with data from offset wells.Data from a four well pad was used to validate the twin. Three of the wells were used as a historical data reference, and the twin was run on the fourth well for validation. Before drilling starts, an initial estimate of time to section depth is made using the historical data. Subsequently, as drilling gets underway, the prediction gets updated with new data. This update is performed by using a dynamic weighting scheme for the data points collected at different times. The time-based predictions to total depth generated by a digital twin can help plan and optimize the logistics on a rig. Moreover, digital twins can help predict and thereby prevent unwanted failures, reducing the likelihood of non-productive time events. This can bring about significant benefits in terms of reducing well construction time and unnecessary trouble cost.},
author = {Saini, Gurtej and Ashok, Pradeepkumar and van Oort, Eric and Isbell, Matthew R},
booktitle = {SPE/AAPG/SEG Unconventional Resources Technology Conference},
doi = {10.15530/urtec-2018-2902186},
file = {:C$\backslash$:/Users/1540 LITE/Documents/Mendeley Desktop/Saini et al/SPEAAPGSEG Unconventional Resources Technology Conference/Saini et al. - 2018 - Accelerating Well Construction Using a Digital Twin Demonstrated on Unconventional Well Data in North America.pdf:pdf},
title = {{Accelerating Well Construction Using a Digital Twin Demonstrated on Unconventional Well Data in North America}},
year = {2018}
}

